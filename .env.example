NODE_ENV=development
PORT=4000

# Local development origins. In production, set exact HTTPS origins without paths.
STORE_ORIGINS=http://localhost:5173
ADMIN_ORIGINS=http://localhost:5174
ALLOW_LAN_ORIGINS=true

SESSION_TTL_HOURS=12
COOKIE_SECURE=false

# Replace both values before exposing the API to the internet.
ADMIN_EMAILS=admin@example.com
SUPPORT_EMAILS=
BOOTSTRAP_PASSWORD=replace-with-a-long-unique-password

# Customer-initiated WhatsApp Click-to-Chat needs no API credentials.
WHATSAPP_PROVIDER=log

UPLOAD_MAX_BYTES=4194304

# For a persistent production volume, configure these on the API host.
# DATA_DIR=/var/data
# DB_FILE=/var/data/store.db
# UPLOAD_DIR=/var/data/uploads
